<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>Badassium238: per-line colour separation for SHO narrowband images.</p>
      <p>Add https://jps-34.github.io/Badassium238/ under Resources &gt; Updates &gt; Manage Repositories.</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.4:1.9.99">
      <package fileName="Badassium238-1.2.5-PI194.zip" sha1="719c29120052fa77c668707c910acfc881136453" type="script" releaseDate="20261027" serverURL="https://jps-34.github.io/Badassium238/">
         <title>Badassium238 1.2.5 (PixInsight 1.9.4 and later)</title>
         <description>
            <p>Breaks the two-colour look of SHO images: finds which emission lines end up with the same hue, then gives each line its own colour (for example SII red, Ha gold, OIII blue) by a hue-only rotation at constant luminance, with live preview and optional palette presets. English or French interface. The original image is never modified. Installs under Script &gt; JPS &gt; Badassium238.</p>
            <p>Copyright (c) 2026 Jacques Pouyaud. GNU GPL v3 or later. Source: https://github.com/jps-34/Badassium238</p>
         </description>
      </package>
   </platform>
   <platform os="all" arch="noarch" version="1.8.9-3:1.9.3">
      <package fileName="Badassium238-1.1.1-PI193.zip" sha1="dad48084454761ca13dea39b8667b191718cba94" type="script" releaseDate="20261027" serverURL="https://jps-34.github.io/Badassium238/">
         <title>Badassium238 1.1.1 (PixInsight 1.9.3 and earlier)</title>
         <description>
            <p>Same tool for the legacy JavaScript engine of PixInsight 1.9.3 and earlier. Installs under Script &gt; Utilities &gt; Badassium238 PI193.</p>
            <p>Copyright (c) 2026 Jacques Pouyaud. GNU GPL v3 or later. Source: https://github.com/jps-34/Badassium238</p>
         </description>
      </package>
   </platform>
</xri>
